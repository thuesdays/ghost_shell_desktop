+              if (pv) config.meta.platform_version = *pv;
+              
+              const std::string* a = m_dict->FindString("architecture");
+              if (a) config.meta.architecture = *a;
+              
+              const std::string* m = m_dict->FindString("model");
+              if (m) config.meta.model = *m;
+              
+              const std::string* b = m_dict->FindString("bitness");
+              if (b) config.meta.bitness = *b;
+              
+              const std::string* fv = m_dict->FindString("full_version");
+              if (fv) config.meta.full_version = *fv;
+              
+              config.meta.wow64 = m_dict->FindBool("wow64").value_or(false);
+              config.meta.mobile = m_dict->FindBool("mobile").value_or(false);
+              config.meta.form_factors = {"Desktop"};
