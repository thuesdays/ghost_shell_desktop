+// === GHOST SHELL BROWSER CONFIG ===
+//
+// audit PCP-02: this struct used to ALSO parse a full blink::UserAgentMetadata
+// (`meta`) and GetUserAgentMetadata() returned it directly. That created a
+// SECOND, divergent UA-CH parser alongside embedder_support::GhostShellUAOverride
+// (consumed by embedder_support::GetUserAgentMetadata()): the two could produce
+// different brand orderings / form factors for the same profile depending on
+// which entry point the network stack hit, and `meta` hardcoded
+// form_factors = {"Desktop"} regardless of the payload (mobile bit set but
+// Desktop form factor — an internal contradiction). It has been collapsed to a
+// SINGLE source of truth: GetUserAgentMetadata() now routes through
+// embedder_support::GetUserAgentMetadata() (which consults GhostShellUAOverride,
+// now also parsing form_factors). This struct retains ONLY the legacy UA string
+// for GetUserAgent().
+struct GhostBrowserConfig {
+  bool is_active = false;
+  std::string user_agent;
+
+  static const GhostBrowserConfig& Get() {
+    static base::NoDestructor<GhostBrowserConfig> instance([]() {
+      GhostBrowserConfig config;
+      base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+
+      if (cmd->HasSwitch("ghost-shell-payload")) {
+        std::string b64_payload = cmd->GetSwitchValueASCII("ghost-shell-payload");
+        std::string json;
+
+        if (base::Base64Decode(b64_payload, &json)) {
+          auto parsed = base::JSONReader::Read(json, 0);
+          if (parsed && parsed->is_dict()) {
+            config.is_active = true;
+            const auto& d = parsed->GetDict();
+
+            // Legacy User-Agent string (navigator.userAgent / UA header).
+            const auto* hw = d.FindDict("hardware");
+            if (hw) {
+              const std::string* ua = hw->FindString("user_agent");
+              if (ua) config.user_agent = *ua;
+            }
+          }
+        }
+      }
+      return config;
+    }());
+    return *instance;
+  }
+};
+// === END GHOST SHELL BROWSER CONFIG ===
+
 std::string ChromeContentBrowserClient::GetUserAgent() {
+  if (GhostBrowserConfig::Get().is_active && !GhostBrowserConfig::Get().user_agent.empty()) {
+    return GhostBrowserConfig::Get().user_agent;
+  }
   return embedder_support::GetUserAgent();
 }
 
 blink::UserAgentMetadata ChromeContentBrowserClient::GetUserAgentMetadata() {
   DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  // audit PCP-02: single source of truth — route through embedder_support,
+  // which consults GhostShellUAOverride. This guarantees the Sec-CH-UA-*
+  // subresource headers (built by embedder_support::GetUserAgentMetadata) and
+  // navigator.userAgentData (this entry point) originate from one parsed
+  // struct and can never drift in brand ordering or form factor.
   return embedder_support::GetUserAgentMetadata();
 }
 
