+    return "vp9";
+  }
+  if (ct.contains("vp08") || ct.contains("vp8")) {
+    return "vp8";
+  }
+  if (ct.contains("avc1") || ct.contains("avc3") || ct.contains("h264")) {
+    return "h264";
+  }
