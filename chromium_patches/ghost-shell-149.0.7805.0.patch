+// === GHOST SHELL ===
+std::optional<PermissionResult> GetGhostShellPermission(PermissionType type) {
+  static base::NoDestructor<base::DictValue> gs_perms([]() -> base::DictValue {
+    base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    if (cmd && cmd->HasSwitch("ghost-shell-payload")) {
+      std::string json;
+      if (base::Base64Decode(cmd->GetSwitchValueASCII("ghost-shell-payload"), &json)) {
+        if (auto val = base::JSONReader::Read(json, 0)) {
+          if (val->is_dict()) {
+            if (auto* perms = val->GetIfDict()->FindDict("permissions")) {
+              return perms->Clone();
+            }
+          }
+        }
+      }
+    }
+    return base::DictValue();
+  }());
+
+  if (gs_perms->empty()) return std::nullopt;
+
+  std::string name;
+  if (type == PermissionType::GEOLOCATION) name = "geolocation";
+  else if (type == PermissionType::NOTIFICATIONS) name = "notifications";
+  else if (type == PermissionType::VIDEO_CAPTURE) name = "camera";
+  else if (type == PermissionType::AUDIO_CAPTURE) name = "microphone";
+  else return std::nullopt;
+
+  const std::string* state = gs_perms->FindString(name);
+  if (!state) return std::nullopt;
+
+  if (*state == "granted") return PermissionResult(PermissionStatus::GRANTED, PermissionStatusSource::UNSPECIFIED);
+  if (*state == "denied") return PermissionResult(PermissionStatus::DENIED, PermissionStatusSource::UNSPECIFIED);
+  return PermissionResult(PermissionStatus::ASK, PermissionStatusSource::UNSPECIFIED);
+}
+// === END GHOST SHELL ===
