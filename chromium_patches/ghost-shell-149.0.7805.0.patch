+  for (int y = 0; y < h; ++y) {
+    uint8_t* row = static_cast<uint8_t*>(dst->writable_addr(0, y));
+    if (!row) continue;
+    for (int x = 0; x < w; ++x) {
+      const uint64_t k = GhostShellMix(
+          seed ^ static_cast<uint64_t>(x) ^
+          (static_cast<uint64_t>(y) << 32));
