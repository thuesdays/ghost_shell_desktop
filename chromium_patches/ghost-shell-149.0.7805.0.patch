+      ct.contains("hevc")) {
+    return "h265";
+  }
+  // Audio codecs.
+  if (ct.contains("opus")) {
+    return "opus";
+  }
+  if (ct.contains("mp4a") || ct.contains("aac")) {
+    return "aac";
+  }
+  if (ct.contains("flac")) {
+    return "flac";
+  }
+  if (ct.contains("mp3") || ct.contains("mpeg")) {
+    return "mp3";
+  }
