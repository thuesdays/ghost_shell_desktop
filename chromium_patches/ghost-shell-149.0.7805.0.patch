+
+bool GhostShellIsHostScopeAddress(const net::IPAddress& a) {
+  if (a.IsLoopback() || a.IsLinkLocal() || a.IsZero()) {
+    return true;
+  }
+  // IPv4 RFC1918: 10/8, 172.16/12, 192.168/16, 100.64/10 (CGNAT).
+  if (a.IsIPv4()) {
+    const auto& b = a.bytes();
+    if (b[0] == 10) return true;
+    if (b[0] == 172 && (b[1] & 0xF0) == 0x10) return true;
+    if (b[0] == 192 && b[1] == 168) return true;
+    if (b[0] == 100 && (b[1] & 0xC0) == 0x40) return true;
+  }
+  // IPv6 ULA: fc00::/7.
+  if (a.IsIPv6()) {
+    const auto& b = a.bytes();
+    if ((b[0] & 0xFE) == 0xFC) return true;
+  }
+  return false;
+}
