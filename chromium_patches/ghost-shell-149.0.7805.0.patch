+              if (full_list) {
+                for (const auto& item : *full_list) {
+                  if (item.is_dict()) {
+                    const std::string* b_name = item.GetDict().FindString("brand");
+                    const std::string* b_version = item.GetDict().FindString("version");
+                    if (b_name && b_version) {
+                        config.meta.brand_full_version_list.emplace_back(*b_name, *b_version);
