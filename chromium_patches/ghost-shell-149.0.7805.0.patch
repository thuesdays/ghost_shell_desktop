+// === GHOST SHELL ===
+std::optional<PermissionResult> GetGhostShellPermission(PermissionType type) {
+  static base::NoDestructor<base::DictValue> gs_perms([]() -> base::DictValue {
+    base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    if (cmd && cmd->HasSwitch("ghost-shell-payload")) {
+      std::string json;
+      if (base::Base64Decode(cmd->GetSwitchValueASCII("ghost-shell-payload"), &json)) {
+        if (auto val = base::JSONReader::Read(json, 0)) {
+          if (val->is_dict()) {
+            if (auto* perms = val->GetIfDict()->FindDict("permissions")) {
+              return perms->Clone();
+            }
+          }
+        }
+      }
+    }
+    return base::DictValue();
+  }());
+
+  if (gs_perms->empty()) return std::nullopt;
+
+  // audit PERM-01/CFG-02: this browser-side mapping MUST cover the same name
+  // set as the renderer-side navigator.permissions.query() spoof
+  // (permissions.cc) and GhostShellConfig::GetPermissionState(), otherwise
+  // query() can report e.g. "clipboard-read" granted while the browser falls
+  // through to native (prompt/deny) on actual use — a classic lie-detector
+  // hit. Names are the W3C dash-form keys the payload uses (the same keys the
+  // renderer normalizes underscores to). Keep this table in sync with the
+  // PermissionType -> string mapping the renderer derives from
+  // PermissionNameToString.
+  std::string name;
+  switch (type) {
+    case PermissionType::GEOLOCATION:
+    case PermissionType::GEOLOCATION_APPROXIMATE:
+      name = "geolocation";
+      break;
+    case PermissionType::NOTIFICATIONS:
+      name = "notifications";
+      break;
+    case PermissionType::VIDEO_CAPTURE:
+    case PermissionType::CAMERA_PAN_TILT_ZOOM:
+      name = "camera";
+      break;
+    case PermissionType::AUDIO_CAPTURE:
+      name = "microphone";
+      break;
+    case PermissionType::MIDI:
+    case PermissionType::MIDI_SYSEX:
+      name = "midi";
+      break;
+    case PermissionType::CLIPBOARD_READ_WRITE:
+      name = "clipboard-read";
+      break;
+    case PermissionType::CLIPBOARD_SANITIZED_WRITE:
+      name = "clipboard-write";
+      break;
+    case PermissionType::WAKE_LOCK_SCREEN:
+      name = "screen-wake-lock";
+      break;
+    case PermissionType::WAKE_LOCK_SYSTEM:
+      name = "system-wake-lock";
+      break;
+    case PermissionType::SENSORS:
+      name = "accelerometer";  // grouped sensor permission (also gyroscope,
+                               // magnetometer, ambient-light-sensor)
+      break;
+    case PermissionType::WINDOW_MANAGEMENT:
+      name = "window-management";
+      break;
+    case PermissionType::LOCAL_FONTS:
+      name = "local-fonts";
+      break;
+    case PermissionType::IDLE_DETECTION:
+      name = "idle-detection";
+      break;
+    case PermissionType::PERIODIC_BACKGROUND_SYNC:
+      name = "periodic-background-sync";
+      break;
+    case PermissionType::BACKGROUND_SYNC:
+      name = "background-sync";
+      break;
+    case PermissionType::PAYMENT_HANDLER:
+      name = "payment-handler";
+      break;
+    case PermissionType::PERSISTENT_STORAGE:
+      name = "persistent-storage";
+      break;
+    case PermissionType::STORAGE_ACCESS_GRANT:
+      name = "storage-access";
+      break;
+    case PermissionType::TOP_LEVEL_STORAGE_ACCESS:
+      name = "top-level-storage-access";
+      break;
+    case PermissionType::DISPLAY_CAPTURE:
+      name = "display-capture";
+      break;
+    case PermissionType::SPEAKER_SELECTION:
+      name = "speaker-selection";
+      break;
+    case PermissionType::CAPTURED_SURFACE_CONTROL:
+      name = "captured-surface-control";
+      break;
+    default:
+      // Unmapped types (AR/VR/NFC/PROTECTED_MEDIA_IDENTIFIER/etc.) fall
+      // through to native — the renderer spoof only resolves names present in
+      // the payload, so the two sides still agree (both decline to spoof).
+      return std::nullopt;
+  }
+
+  // For sensor permissions, the W3C exposes several named sensors that all
+  // map to the single SENSORS PermissionType. Accept whichever of them the
+  // payload specified so query({name:'gyroscope'}) etc. agree with gating.
+  const std::string* state = gs_perms->FindString(name);
+  if (!state && type == PermissionType::SENSORS) {
+    for (const char* alias : {"gyroscope", "magnetometer", "accelerometer",
+                              "ambient-light-sensor"}) {
+      state = gs_perms->FindString(alias);
+      if (state) break;
+    }
+  }
+  if (!state) return std::nullopt;
+
+  if (*state == "granted") return PermissionResult(PermissionStatus::GRANTED, PermissionStatusSource::UNSPECIFIED);
+  if (*state == "denied") return PermissionResult(PermissionStatus::DENIED, PermissionStatusSource::UNSPECIFIED);
+  return PermissionResult(PermissionStatus::ASK, PermissionStatusSource::UNSPECIFIED);
+}
