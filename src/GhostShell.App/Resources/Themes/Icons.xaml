  Redesign 2026-06 — vector icon library ("Lucide"-style).

  Replaces the Segoe MDL2 Assets glyph font (Win10-only, dated) with
  stroke-based vector geometries authored on a 24×24 grid. Rendered by
  the GhostShell.App.Controls.Icon control (implicit style below): a
  Viewbox scales the 24×24 Path uniformly to Icon.Size, so icons are
  razor-sharp at any DPI and recolour via Icon.Stroke (per-page hue).

  Usage:
    <ctrl:Icon Data="{StaticResource Icon.Profiles}"
               Stroke="{DynamicResource HueGreen}" Size="18"/>

  Add an icon = one PathGeometry below. Migrate a glyph usage =
  swap the <TextBlock FontFamily="Segoe MDL2 Assets" .../> for an
  <ctrl:Icon Data="{StaticResource Icon.X}" .../>.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:GhostShell.App.Controls">

    <!-- ── Implicit template for the Icon control ─────────────────── -->
    <Style TargetType="{x:Type ctrl:Icon}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Stroke" Value="{DynamicResource Text}"/>
        <Setter Property="Width"  Value="{Binding Size, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Height" Value="{Binding Size, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:Icon}">
                    <Viewbox Stretch="Uniform">
                        <Path Width="24" Height="24"
                              Data="{TemplateBinding Data}"
                              Stroke="{TemplateBinding Stroke}"
                              StrokeThickness="{TemplateBinding StrokeThickness}"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

