<UserControl x:Class="GhostShell.App.Views.GroupsView"
             x:Name="PageRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GhostShell.App.ViewModels"
             xmlns:common="clr-namespace:GhostShell.App.Common"
             xmlns:ctrl="clr-namespace:GhostShell.App.Controls"
             d:DataContext="{d:DesignInstance Type=vm:GroupsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             AutomationProperties.AutomationId="page.groups"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Row context menu — Edit / Delete -->
        <ContextMenu x:Key="GroupRowMenu"
                     DataContext="{Binding DataContext, Source={x:Reference PageRoot}}">
            <MenuItem Header="Edit…"
                      Command="{Binding EditCommand}"
                      CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                  Path=PlacementTarget.DataContext}"/>
            <Separator/>
            <MenuItem Header="Delete"
                      Command="{Binding DeleteCommand}"
                      CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                  Path=PlacementTarget.DataContext}"/>
        </ContextMenu>
    </UserControl.Resources>

    <!-- Phase 71s — busy overlay moved to MainWindow (window-level
         blur + spinner so the sidebar gets dimmed too). -->
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="Auto"/>  <!-- search -->
            <RowDefinition Height="*"/>     <!-- content -->
        </Grid.RowDefinitions>

        <!-- Header + toolbar — title/buttons share row 0, subtitle gets
             full width on row 1 so it doesn't wrap awkwardly next to
             the buttons at narrow window sizes. -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource PageTitle}"
                           Text="Profile groups"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+  Create group"
                            Command="{Binding AddCommand}"
                            Style="{StaticResource ButtonPrimary}"
                            AutomationProperties.AutomationId="groups.create"
                            MinWidth="140"/>
                </WrapPanel>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}"
                    Padding="14,10" Margin="0,12,0,0">
                <TextBlock Style="{StaticResource PageSubtitle}"
                           TextWrapping="Wrap"
                           Text="Batch-run many profiles at once. Each member runs in its own Chrome with its own proxy."/>
            </Border>
        </Grid>

        <!-- Search row -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter by group name or description"/>
                <TextBlock Grid.Column="1" Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource MutedText}">
                    <Run Text="{Binding Items.Count, Mode=OneWay}"/>
                    <Run Text=" group(s)"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Content — cards (col 0) + crypto-farm detail panel (col 1) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Empty state -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="40"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontSize="48" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextDim}" Text="∅"/>
                    <TextBlock Margin="0,14,0,6" HorizontalAlignment="Center"
                               Style="{StaticResource PageTitle}" FontSize="18"
                               Text="No groups yet"/>
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource MutedText}"
                               Margin="0,0,0,16"
                               Text="Create your first group to batch-run multiple profiles with one click."/>
                    <Button Content="+  Create group"
                            Command="{Binding AddCommand}"
                            Style="{StaticResource ButtonPrimary}"
                            HorizontalAlignment="Center"
                            MinWidth="160"/>
                </StackPanel>
            </Border>

            <!-- Group cards grid -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Phase 71jj — same responsive sizing
                                 we landed on for the Profiles page.
                                 ItemWidth=305 gives uniform cards +
                                 auto-fit columns: 4 per row at
                                 ~1300px usable width, 5 at ~1620px,
                                 6 at ~1940px. Without ItemWidth the
                                 WrapPanel sized cards to their
                                 MinWidth=300 floor and the row was
                                 ragged when names varied in length. -->
                            <WrapPanel Orientation="Horizontal"
                                       ItemWidth="305"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GroupRowVm}">
                            <!-- Compact group card. 2px accent stripe on the
                                 left echoes the sidebar treatment, smaller
                                 padding (12 instead of 16) and tighter
                                 MinHeight (124 instead of 160) so the cards
                                 read as quick-access tiles, not panels. -->
                            <!-- Phase 71jj — MinWidth dropped: the
                                 WrapPanel's ItemWidth governs slot
                                 size now, and a card-level MinWidth
                                 fights with that (forces cells wider
                                 than the slot, breaking the auto-fit
                                 column count). MinHeight stays so
                                 short cards don't dance in height. -->
                            <Border Margin="0,0,12,12"
                                    Background="{StaticResource BgRaised}"
                                    BorderBrush="{StaticResource HueIndigo}"
                                    BorderThickness="2,1,1,1"
                                    CornerRadius="8"
                                    Padding="12"
                                    MinHeight="124"
                                    ContextMenu="{StaticResource GroupRowMenu}">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black"
                                                      BlurRadius="10"
                                                      ShadowDepth="1"
                                                      Opacity="0.35"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header: name + running chip -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <ctrl:Icon Data="{StaticResource Icon.FolderOpen}"
                                                       Size="22"
                                                       Stroke="{StaticResource HueIndigo}"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource Text}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Padding="8,2"
                                                CornerRadius="10" BorderThickness="1"
                                                Background="{StaticResource OkSoftBrush}"
                                                BorderBrush="{StaticResource OkBrush}"
                                                Visibility="{Binding HasRunning, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource PillText}"
                                                       Foreground="{StaticResource OkBrush}"
                                                       Text="{Binding RunningLabel}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Meta: members + cap -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Foreground="{StaticResource Accent}"
                                                   FontFamily="{StaticResource FontMono}"
                                                   FontSize="12">
                                            <Run Text="{Binding MemberCount, Mode=OneWay}"/>
                                            <Run Text=" member(s)"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource MutedText}" FontSize="11"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Text="·"/>
                                        <TextBlock Style="{StaticResource MutedText}" FontSize="11"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Text="{Binding CapLabel}"/>
                                    </StackPanel>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="2"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,12,0,0"
                                               TextWrapping="Wrap"
                                               Text="{Binding Description, FallbackValue='—'}"/>

                                    <!-- Actions — two rows so the labelled buttons
                                         get the full card width (no text clipping),
                                         with icon actions on a compact second row. -->
                                    <Grid Grid.Row="3" Margin="0,12,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: primary Start / Stop, split full width -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Margin="0,0,4,0" Padding="10,7"
                                                    Style="{StaticResource ButtonPrimary}"
                                                    Command="{Binding DataContext.StartGroupCommand,
                                                              Source={x:Reference PageRoot}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ctrl:Icon Data="{StaticResource Icon.Play}" Size="16"
                                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Start group" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Margin="4,0,0,0" Padding="10,7"
                                                    Style="{StaticResource ButtonDanger}"
                                                    IsEnabled="{Binding HasRunning}"
                                                    Command="{Binding DataContext.StopGroupCommand,
                                                              Source={x:Reference PageRoot}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ctrl:Icon Data="{StaticResource Icon.Stop}" Size="16"
                                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock VerticalAlignment="Center">
                                                        <Run Text="Stop "/>
                                                        <Run Text="{Binding RunningCount, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Row 1: secondary icon actions, right-aligned -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal"
                                                    HorizontalAlignment="Right" Margin="0,6,0,0">
                                            <Button Margin="0,0,4,0" Padding="8,3"
                                                    ToolTip="Open the crypto-farm panel for this group"
                                                    AutomationProperties.AutomationId="{Binding Name, StringFormat='groups.farm.open.{0}'}"
                                                    Command="{Binding DataContext.OpenFarmCommand,
                                                              Source={x:Reference PageRoot}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="🪙 Farm" FontSize="12" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Style="{StaticResource RowActionButton}" Margin="0,0,4,0"
                                                    ToolTip="Edit group"
                                                    Command="{Binding DataContext.EditCommand,
                                                              Source={x:Reference PageRoot}}"
                                                    CommandParameter="{Binding}">
                                                <ctrl:Icon Data="{StaticResource Icon.Edit}" Size="18"
                                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Button>
                                            <Button Style="{StaticResource RowActionDanger}"
                                                    ToolTip="Delete group"
                                                    Command="{Binding DataContext.DeleteCommand,
                                                              Source={x:Reference PageRoot}}"
                                                    CommandParameter="{Binding}">
                                                <ctrl:Icon Data="{StaticResource Icon.Trash}" Size="18"
                                                           Stroke="{StaticResource ErrBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ─── Crypto-farm detail panel (col 1) ───────────────────
                 Shown when a group is selected via its "🪙 Farm" button.
                 Lists per-member wallet readiness + a one-click mass run
                 of a chosen task across the whole farm. -->
            <Border Grid.Column="1"
                    Width="380" Margin="12,0,0,0"
                    Style="{StaticResource Card}" Padding="0"
                    Visibility="{Binding HasSelectedGroup, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <!-- Header -->
                    <Grid DockPanel.Dock="Top" Margin="14,12,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text}">
                                <Run Text="🪙  "/>
                                <Run Text="{Binding SelectedGroup.Name, Mode=OneWay, FallbackValue='Farm'}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding FarmSummary}" Margin="0,3,0,0"
                                       Style="{StaticResource MutedText}" FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Padding="8,2" FontSize="12"
                                ToolTip="Close farm panel"
                                AutomationProperties.AutomationId="farm.close"
                                Command="{Binding CloseFarmCommand}"/>
                    </Grid>

                    <!-- Mass-run task bar -->
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}"
                            BorderThickness="0,1,0,1" Padding="14,10"
                            Background="{StaticResource BgDeep}">
                        <StackPanel>
                            <TextBlock Text="Run a task across the whole farm"
                                       Style="{StaticResource MutedText}" FontSize="11"
                                       Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding AvailableScripts}"
                                      SelectedItem="{Binding SelectedFarmScript, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      AutomationProperties.AutomationId="farm.script"
                                      ToolTip="Pick the wallet task (script) to assign + launch on every member"/>
                            <Button Content="▶  Run wallet task on farm"
                                    Margin="0,8,0,0" Padding="10,8"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource ButtonAccent}"
                                    AutomationProperties.AutomationId="farm.run"
                                    Command="{Binding RunWalletTaskCommand}"/>
                            <TextBlock Margin="0,6,0,0" FontSize="10.5"
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       Text="Assigns the selected script to every member (persisted) and launches them with the group's concurrency cap."/>
                        </StackPanel>
                    </Border>

                    <!-- Balance / chain bar -->
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}"
                            BorderThickness="0,0,0,1" Padding="14,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AvailableChains}"
                                      SelectedItem="{Binding SelectedChain, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      AutomationProperties.AutomationId="farm.chain"
                                      ToolTip="Chain to read native balances on"/>
                            <Button Grid.Column="1" Content="💰 Balances" Margin="8,0,0,0" Padding="8,4"
                                    FontSize="11"
                                    AutomationProperties.AutomationId="farm.balances"
                                    Command="{Binding FetchBalancesCommand}"
                                    ToolTip="Fetch each member's native-coin balance (read-only RPC)"/>
                            <Button Grid.Column="2" Content="⚙" Margin="6,0,0,0" Padding="8,4"
                                    FontSize="12"
                                    AutomationProperties.AutomationId="farm.selectors"
                                    Command="{Binding EditWalletSelectorsCommand}"
                                    ToolTip="Edit wallet selector overrides"/>
                        </Grid>
                    </Border>

                    <!-- Refresh -->
                    <Button DockPanel.Dock="Top" Content="⟳  Refresh readiness"
                            Margin="14,8,14,4" Padding="6,4" HorizontalAlignment="Left"
                            FontSize="11"
                            AutomationProperties.AutomationId="farm.refresh"
                            Command="{Binding RefreshFarmCommand}"/>

                    <!-- Member readiness list -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,0,6,8">
                        <ItemsControl ItemsSource="{Binding FarmMembers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FarmMemberRowVm}">
                                    <Border Margin="8,3" Padding="10,7"
                                            CornerRadius="6"
                                            Background="{StaticResource BgRaised}"
                                            BorderThickness="3,0,0,0"
                                            AutomationProperties.AutomationId="{Binding Name, StringFormat='farm.member.{0}'}"
                                            AutomationProperties.Name="{Binding Name}"
                                            BorderBrush="{Binding StatusBrushKey, Converter={StaticResource ResourceKeyToBrush}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}"
                                                       FontWeight="Bold" FontSize="14"
                                                       VerticalAlignment="Top" Margin="0,0,9,0"
                                                       Foreground="{Binding StatusBrushKey, Converter={StaticResource ResourceKeyToBrush}}"/>
                                            <StackPanel Grid.Column="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource Text}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Balance}"
                                                               FontFamily="{StaticResource FontMono}"
                                                               FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource HueGreen}"
                                                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </Grid>
                                                <TextBlock Text="{Binding AddressMasked}"
                                                           FontFamily="{StaticResource FontMono}"
                                                           FontSize="11" Margin="0,2,0,0"
                                                           Foreground="{StaticResource TextMuted}"
                                                           ToolTip="{Binding AddressFull}"/>
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="10.5" Margin="0,2,0,0"
                                                           Foreground="{StaticResource TextDim}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
